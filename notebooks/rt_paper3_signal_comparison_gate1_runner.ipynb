    "    \"{BUDGETS}\" \\\n",
    "    {MSC_LIMIT} \\\n",
    "    {LONGMEM_LIMIT} \\\n",
    "    {TARGET_STRIDE} \\\n",
    "    {MAX_TARGET_TURNS}"
   ]
  },
  {
   "cell_type": "code",
